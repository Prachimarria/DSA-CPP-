
#include <iostream>
#include <unordered_set>
#include <vector>

//Slow and Fast approch
using namespace std;

vector<int> findDuplicate(vector<int> arr){
    int n=arr.size();
    int slow=arr[0],fast=arr[0];
    do{
        slow=arr[slow]; // +1
        fast=arr[arr[fast]]; // +2
        
    }
    while(slow!=fast);
    slow=arr[0];
    while(slow!=fast){
        slow=arr[slow]; // +1
        fast=arr[fast];  //+1
    }
    return {slow};
    
}

int main() {
   vector<int> arr ={4,8,6,5,3,4};
   vector<int> ans=findDuplicate(arr);
   for(int i=0;i<ans.size();i++){
       cout<<ans[i];
   }
    return 0;
}
