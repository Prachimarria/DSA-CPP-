
#include <iostream>
#include <unordered_set>
#include <vector>
using namespace std;

vector<int> MissingAndReapeating(vector<vector<int>> arr){
    int n=arr.size();
    unordered_set<int> s;
    vector<int> ans;
    int expectedsum=0,actualsum=0,a,b;
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            actualsum+=arr[i][j];
            if(s.find(arr[i][j])!=s.end()){
                a=arr[i][j];
                ans.push_back(a);
            }
            s.insert(arr[i][j]);
        }
        }
        expectedsum=n*n*((n*n)+1)/2;
        b=expectedsum+a-actualsum;
        ans.push_back(b);
        return ans;
}

int main() {
   vector<vector<int>> arr ={{9,1,7},{8,9,2},{3,4,6}};
   vector<int> ans=MissingAndReapeating(arr);
   for (int i = 0; i < ans.size(); i++) {
    cout << ans[i];
    if (i != ans.size() - 1) cout << ",";
}
    return 0;
}
